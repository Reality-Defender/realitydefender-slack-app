# Slack app credentials (multi-workspace OAuth)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Shared key for LOCAL DEV ONLY. When set, it is used as a fallback for any
# workspace without its own key. Leave it UNSET in production so each workspace
# registers its own key via /setup-rd.
REALITY_DEFENDER_API_KEY=

# Durable storage (production). Leave these unset for local dev — the app then
# uses ephemeral in-memory / file stores and needs no AWS credentials.
# Set ALL THREE table names to enable DynamoDB-backed storage.
AWS_REGION=
DYNAMODB_INSTALLATIONS_TABLE=
DYNAMODB_OAUTH_STATES_TABLE=
DYNAMODB_RD_KEYS_TABLE=
# KMS key (id, ARN, or alias) used to encrypt RD API keys before they are
# written to DynamoDB. Required whenever DynamoDB storage is enabled.
RD_KEY_KMS_KEY_ID=

LOG_LEVEL=INFO
PORT=3000
