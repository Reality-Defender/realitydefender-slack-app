    <div class="product"><svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 5V2h3M11 2h3v3M14 11v3h-3M5 14H2v-3"/><rect x="5" y="5" width="6" height="6"/></svg>RealScan</div>
  </header>

  <h1>{{ r.kind_title }}</h1>
  <div class="subject">{{ media_icon(r.media_type) }}<span>{{ r.title }}</span></div>

  <div class="chip tone-{{ r.conclusion_tone }}">
    <span class="chip-label">Conclusion:</span>
    {{ bars(r.conclusion_tone, levels[r.conclusion_tone], r.conclusion_label) }}
    <strong>{{ r.conclusion_label }}</strong>
  </div>

  <div class="preview">
    {% if r.preview %}
    <img src="{{ r.preview }}" alt="Preview of the analyzed media">
    {% elif r.media_type == 'AUDIO' %}
    <svg class="wave" viewBox="0 0 {{ waveform|length * 6 }} 60" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {% for h in waveform %}<rect x="{{ loop.index0 * 6 }}" y="{{ 30 - h / 2 }}" width="1.6" height="{{ h }}" rx=".8" fill="#7a7980"/>{% endfor %}
    </svg>
    {% else %}
    <div class="no-preview">{{ media_icon(r.media_type) }}</div>
    {% endif %}
  </div>

  <table class="facts">
    {% for f in r.cover_facts %}
    <tr>
      <th>{{ glyph(f.label) }}<span>{{ f.label }}</span></th>
      <td class="{{ 'mono' if f.mono else '' }}">{% if f.href %}<a href="{{ f.href }}">{{ f.value }}</a>{% else %}{{ f.value }}{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
</section>

{# ---------------- Analysis models ---------------- #}
<section class="page">
  <h2>Analysis models</h2>
  <p class="lede">Reality Defender uses a multi-model ensemble. No single model determines the verdict.</p>

  <div class="banner tone-{{ r.conclusion_tone }}">
    <div class="banner-kicker">{{ 'Overall conclusion' if r.is_conclusive else r.conclusion_label }}</div>
    <div class="banner-title">{{ r.conclusion_label if r.is_conclusive else (r.status_label if r.status != 'UNABLE_TO_EVALUATE' else 'Processing error') }}</div>
    <p>{{ r.conclusion_text }}</p>
  </div>

  {% if r.model_tables %}
  <h3>Media analysis</h3>
  {% for t in r.model_tables %}
  <div class="split">
    <div class="split-desc">
      <div class="split-title">{{ t.title }}</div>
      <p>{{ t.description }}</p>
    </div>
    <table class="models">
      <thead><tr><th>Manipulation technique</th><th class="c-icon">Detected</th></tr></thead>
      <tbody>
      {% for m in t.rows %}
      <tr><td>{{ m.name }}</td><td class="c-icon">{{ state_icon(m.state) }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
  {% set any_suspicious = r.model_tables | map(attribute='rows') | sum(start=[]) | selectattr('state', 'equalto', 'suspicious') | list %}
  <div class="legend">{{ bars('danger', 3, 'Detected') }}<span>Signs of manipulation detected</span>{% if any_suspicious %}{{ bars('warning', 2, 'Suspicious') }}<span>Suspicious</span>{% endif %}{{ bars('ok', 1, 'Not detected') }}<span>Not detected</span></div>
  {% endif %}

  {% if r.heatmap %}
  <div class="split keep">
    <div class="split-desc">
      <div class="split-title">Detection Heatmap</div>
      <p>Where the detectors that flagged this image found the strongest signals. Red areas had the most influence on the result.</p>
    </div>
    <div class="heatmap"><img src="{{ r.heatmap }}" alt="Detection heatmap"></div>
  </div>
  {% endif %}
</section>

{# ---------------- Context analysis ---------------- #}
{% if r.context_rows %}
<section class="block">
  <h2>Context analysis</h2>
  <table class="outcomes">
    {% for o in r.context_rows %}
    <tr><th>{{ state_icon(o.state) }}<span>{{ o.label }}</span></th><td>{{ o.text }}</td></tr>
    {% endfor %}
  </table>
  {% if r.sources %}
  <div class="sources">
    {% for s in r.sources %}
    <div class="source">
      <div class="source-site">{{ s.source or 'Web' }}</div>
      <a href="{{ s.url }}">{{ s.title }}</a>
      {% if s.date %}<div class="source-date">{{ s.date }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

{# ---------------- Metadata analysis ---------------- #}
{% if r.metadata %}
<section class="block keep">
  <h2>Metadata analysis</h2>
  <div class="split">
    <div class="split-desc">
      <div class="split-title">Metadata signals</div>
      <p>File-level signals that reveal how media was created, processed, or modified, including embedded AI and software markers.</p>
    </div>
    <div class="split-body">
      {% if r.metadata.signals %}
      <ul class="signals">{% for s in r.metadata.signals %}<li>{{ detected(true) }}<span>&ldquo;{{ s }}&rdquo;</span></li>{% endfor %}</ul>
      {% else %}
      <div class="signal-none">{{ detected(false) }}<span>No metadata signals to suggest this media has been manipulated.</span></div>
      {% endif %}
    </div>
  </div>
  {% if r.metadata.exif %}
  <div class="split">
    <div class="split-desc">
      <div class="split-title">EXIF tags</div>
      <p>Standard metadata recorded by cameras and editing software.</p>
    </div>
    <table class="kv">{% for f in r.metadata.exif %}<tr><th>{{ f.label }}</th><td>{{ f.value }}</td></tr>{% endfor %}</table>
  </div>
  {% endif %}
  {% if r.metadata.c2pa %}
  <div class="split">
    <div class="split-desc">
      <div class="split-title">C2PA indicators</div>
      <p>Cryptographically verified content credentials that record a file's origin and edits.</p>
    </div>
    <div class="split-body">{% for c in r.metadata.c2pa %}<span class="tag">{{ c }}</span>{% endfor %}</div>
  </div>
  {% endif %}
</section>
{% endif %}

{# ---------------- Known limitations ---------------- #}
<section class="block keep">
  <h2>Known limitations</h2>
  <p class="lede">Results represent probabilistic assessments based on multi-model ensemble analysis. Key limitations to note:</p>
  <ul class="limits">{% for l in r.limitations %}<li>{{ l }}</li>{% endfor %}</ul>
  {% if r.dashboard_url %}<p class="lede small">Reality Defender account holders can view the full analysis <a href="{{ r.dashboard_url }}">online</a>.</p>{% endif %}
</section>

</body>
</html>
