{#- Signal-bar icon from the RealScan design. level: 3 manipulated/detected,
    2 suspicious, 1 authentic/not detected, 0 inconclusive. -#}
{#- Fills are inline attributes: WeasyPrint doesn't apply page CSS inside SVG. -#}
{#- RealScan design colors (independent of the Slack message's emoji). -#}
{% set bar_colors = {'danger': '#b5412b', 'warning': '#b8792a', 'ok': '#5f6b1f', 'neutral': '#b9b8bf'} %}
{% macro bars(tone, level, label='') -%}
{%- set on = bar_colors.get(tone, '#b9b8bf') -%}{%- set off = '#d9d8dd' -%}
<svg class="bars" viewBox="0 0 12 12" role="img" aria-label="{{ label }}"><title>{{ label }}</title><rect x="1" y="7" width="2" height="4" rx=".5" fill="{{ on if level >= 1 else off }}"/><rect x="5" y="4" width="2" height="7" rx=".5" fill="{{ on if level >= 2 else off }}"/><rect x="9" y="1" width="2" height="10" rx=".5" fill="{{ on if level >= 3 else off }}"/></svg>
{%- endmacro %}
{% macro detected(flag) -%}
{%- if flag -%}{{ bars('danger', 3, 'Detected') }}{%- else -%}{{ bars('ok', 1, 'Not detected') }}{%- endif -%}
{%- endmacro %}
{% macro state_icon(state) -%}
{%- if state == 'detected' -%}{{ bars('danger', 3, 'Detected') }}
{%- elif state == 'suspicious' -%}{{ bars('warning', 2, 'Suspicious') }}
{%- else -%}{{ bars('ok', 1, 'Not detected') }}{%- endif -%}
{%- endmacro %}
{% set levels = {'danger': 3, 'warning': 2, 'ok': 1, 'neutral': 0} %}
{% macro glyph(name) -%}
<svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
{%- if name == 'Prepared for' -%}<rect x="3.5" y="2.5" width="9" height="11" rx="1"/><path d="M6 2.5h4v2H6zM6 7.5h4M6 10h4"/>
{%- elif name == 'Submitted by' -%}<circle cx="8" cy="5.5" r="2.5"/><path d="M3 13.5c.8-2.6 2.7-4 5-4s4.2 1.4 5 4"/>
{%- elif name in ('Media submitted', 'Report created') -%}<rect x="2.5" y="3.5" width="11" height="10" rx="1"/><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3"/>
{%- elif name == 'Slack' or name == 'Link' -%}<path d="M7 9a3 3 0 0 0 4.2 0l2-2a3 3 0 0 0-4.2-4.2l-.7.7M9 7a3 3 0 0 0-4.2 0l-2 2A3 3 0 0 0 7 13.2l.7-.7"/>
{%- else -%}<path d="M6 2.5 5 13.5M11 2.5l-1 11M2.5 6h11M2.5 10h11"/>
{%- endif -%}</svg>
{%- endmacro %}
{% macro media_icon(kind) -%}
<svg class="media-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
{%- if kind == 'VIDEO' -%}<rect x="1.5" y="3.5" width="9" height="9" rx="1"/><path d="m10.5 7 4-2.5v7l-4-2.5"/>
{%- elif kind == 'AUDIO' -%}<path d="M2 7v2M4.5 5v6M7 3v10M9.5 5v6M12 6.5v3M14.5 7.5v1"/>
{%- else -%}<rect x="1.5" y="2.5" width="13" height="11" rx="1"/><circle cx="5.5" cy="6" r="1.3"/><path d="m1.5 12 4-4 3 3 2-2 4 4"/>
{%- endif -%}</svg>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.kind_title }} · {{ r.title }}</title>
<style>
/* RealScan report design (Web App 2.0): white pages, tinted
   conclusion chip/banner, signal-bar icons, icon-led details list. */
:root {
  --ink: #1d1c22;
  --muted: #8b8a93;
  --rule: #e7e6e9;
  --panel: #f4f4f4;

  --ok-text: #5f6b1f;
  --ok-chip: #eff0e6;
  --ok-banner: #e8e8dd;
  --warn-text: #b8792a;
  --warn-chip: #f8f0e4;
  --warn-banner: #f2e9dd;
  --danger-text: #b5412b;
  --danger-chip: #f7ebe8;
  --danger-banner: #efe3e0;
  --neutral-text: #7b7a82;
  --neutral-chip: #f6f6f6;
  --neutral-banner: #f0efee;
}

@page {
  size: A4;
  margin: 0.6in 0.7in 0.7in 0.7in;
  @bottom-left { content: element(footer-left); }
  @bottom-right {
    content: counter(page);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 7pt;
    color: #8b8a93;
  }
}
@page :first {
  @bottom-left { content: none; }
  @bottom-right { content: none; }
}

* { box-sizing: border-box; }
html, body { background: #fff; }
body {
  margin: 0;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-weight: 400;
  font-size: 9.5pt;
  line-height: 1.45;
  color: var(--ink);
}
a { color: var(--ink); text-decoration: underline; text-decoration-color: #c4c3ca; }
strong { font-weight: 600; }
.mono { font-family: "DejaVu Sans Mono", Menlo, monospace; font-size: 8pt; overflow-wrap: anywhere; word-break: break-all; }
.small { font-size: 7.5pt; }

.page-footer-left { position: running(footer-left); font-size: 7pt; color: var(--muted); }

/* Tones */
.tone-ok { --t-text: var(--ok-text); --t-chip: var(--ok-chip); --t-banner: var(--ok-banner); }
.tone-warning { --t-text: var(--warn-text); --t-chip: var(--warn-chip); --t-banner: var(--warn-banner); }
.tone-danger { --t-text: var(--danger-text); --t-chip: var(--danger-chip); --t-banner: var(--danger-banner); }
.tone-neutral { --t-text: var(--neutral-text); --t-chip: var(--neutral-chip); --t-banner: var(--neutral-banner); }

/* Signal-bar icons */
.bars { width: 9pt; height: 9pt; flex: 0 0 auto; vertical-align: -1pt; }
.glyph { width: 11pt; height: 11pt; color: var(--muted); flex: 0 0 auto; }

/* Cover */
.cover { page-break-after: always; break-after: page; }
.brand { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30pt; }
.logo svg { height: 26pt; width: auto; display: block; }
.product { display: flex; align-items: center; gap: 5pt; font-weight: 600; font-size: 9pt; }
.product .glyph { color: var(--ink); }
h1 { font-weight: 300; font-size: 30pt; line-height: 1.1; margin: 0 0 8pt 0; }
.subject { display: flex; align-items: center; gap: 7pt; font-size: 13pt; margin-bottom: 14pt; overflow-wrap: anywhere; word-break: break-all; }
.media-icon { width: 13pt; height: 13pt; flex: 0 0 auto; }

.chip {
  display: flex;
  align-items: center;
  gap: 6pt;
  padding: 7pt 10pt;
  border-radius: 3pt;
  background: var(--t-chip);
  color: var(--t-text);
  font-size: 11pt;
  margin-bottom: 14pt;
}
.chip strong { font-weight: 500; }
.chip .bars { width: 10pt; height: 10pt; }

.preview {
  background: var(--panel);
  border-radius: 4pt;
  height: 3.6in;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18pt;
  overflow: hidden;
}
.preview img { max-width: 100%; max-height: 3.6in; }
.wave { width: 80%; height: 1.4in; }
.no-preview .media-icon { width: 40pt; height: 40pt; color: #b9b8bf; }

.facts th {
  text-align: left;
  font-weight: 400;
  color: var(--muted);
  width: 1.9in;
  padding: 4pt 8pt 4pt 0;
  vertical-align: top;
  white-space: nowrap;
}
.facts th .glyph { margin-right: 7pt; vertical-align: -2pt; }
.facts td { padding: 4pt 0; overflow-wrap: anywhere; }

/* Content pages */
table { border-collapse: collapse; width: 100%; }
h2 { font-weight: 300; font-size: 18pt; margin: 0 0 4pt 0; page-break-after: avoid; break-after: avoid; }
h3 { font-weight: 400; font-size: 12pt; margin: 18pt 0 8pt 0; page-break-after: avoid; break-after: avoid; }
.lede { color: var(--muted); font-size: 8.5pt; margin: 0 0 12pt 0; }
.block { margin-top: 26pt; }
.keep { page-break-inside: avoid; break-inside: avoid; }

.banner {
  background: var(--t-banner);
  border-radius: 4pt;
  padding: 11pt 13pt;
  page-break-inside: avoid;
  break-inside: avoid;
}
.banner-kicker { font-size: 7.5pt; }
.banner-title { font-size: 14pt; color: var(--t-text); margin: 1pt 0 4pt; }
.banner p { margin: 0; font-size: 9.5pt; }

/* Two-column rows (description | content). Floats, not flex: WeasyPrint
   sizes tables inside flex rows incorrectly and they overflow the page. */
.split {
  padding: 12pt 0;
  border-top: 1px solid var(--rule);
  page-break-inside: avoid;
  break-inside: avoid;
}
.split::after { content: ""; display: block; clear: both; }
.split-desc { float: left; width: 1.9in; }
.split-title { font-weight: 500; margin-bottom: 3pt; }
.split-desc p { margin: 0; color: var(--muted); font-size: 8pt; }
.split-body, .heatmap { margin-left: 2.15in; }
/* A4 content width (6.87in) minus the description column. */
.split > table { margin-left: 2.15in; width: 4.7in; }

.models { border: 1px solid var(--rule); }
.models th {
  text-align: left;
  font-weight: 500;
  font-size: 8pt;
  padding: 6pt 9pt;
  border-bottom: 1px solid var(--rule);
  background: #fafafa;
}
.models td { padding: 6pt 9pt; border-bottom: 1px solid var(--rule); }
.models tr:last-child td { border-bottom: none; }
.c-icon { width: 0.9in; text-align: left; }

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4pt;
  font-size: 7pt;
  color: var(--muted);
  margin-top: 2pt;
}
.legend span { margin-right: 10pt; }
.legend span:last-child { margin-right: 0; }

.heatmap img { max-width: 2.6in; max-height: 2.8in; border-radius: 3pt; }

.outcomes th {
  text-align: left;
  font-weight: 500;
  width: 2.1in;
  padding: 8pt 8pt 8pt 0;
  vertical-align: top;
  white-space: nowrap;
  border-bottom: 1px solid var(--rule);
}
.outcomes th .bars { margin-right: 7pt; }
.outcomes td { padding: 8pt 0; border-bottom: 1px solid var(--rule); color: #4a4952; }

.sources { display: flex; flex-wrap: wrap; gap: 12pt 18pt; margin-top: 12pt; padding-left: 2.1in; }
.source { flex: 0 0 calc(50% - 9pt); font-size: 8.5pt; page-break-inside: avoid; break-inside: avoid; overflow-wrap: anywhere; }
.source-site { font-weight: 600; margin-bottom: 1pt; }
.source-date { color: var(--muted); font-size: 7.5pt; margin-top: 2pt; }

.signals { list-style: none; margin: 0; padding: 0; border: 1px solid var(--rule); border-radius: 3pt; }
.signals li { display: flex; align-items: center; gap: 7pt; padding: 7pt 9pt; border-bottom: 1px solid var(--rule); }
.signals li:last-child { border-bottom: none; }
.signal-none { display: flex; align-items: center; gap: 7pt; padding: 7pt 9pt; border: 1px solid var(--rule); border-radius: 3pt; color: #4a4952; }
.kv { border: 1px solid var(--rule); }
.kv th { text-align: left; font-weight: 400; color: var(--muted); padding: 6pt 9pt; width: 1.4in; border-bottom: 1px solid var(--rule); }
.kv td { padding: 6pt 9pt; border-bottom: 1px solid var(--rule); overflow-wrap: anywhere; }
.tag { display: inline-block; background: var(--panel); border-radius: 10pt; padding: 2pt 8pt; margin: 0 4pt 4pt 0; font-size: 8pt; }

.limits { margin: 0; padding-left: 14pt; }
.limits li { margin-bottom: 4pt; }

@media screen {
  body { max-width: 8.27in; margin: 0 auto; padding: 0.6in 0.7in; }
  .page-footer-left { display: none; }
  .cover { margin-bottom: 40pt; }
}
</style>
</head>
